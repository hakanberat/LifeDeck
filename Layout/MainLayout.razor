@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

<a class="ld-skip" href="#main-content">Skip to content</a>
<div @onkeydown="HandleKey" class="ld-shell @(menuOpen ? "nav-open" : "") @(collapsed ? "nav-collapsed" : "")">
    <aside class="ld-sidebar" id="workspace-navigation" aria-label="Workspace">
        <a class="ld-brand" href="" aria-label="LifeDeck overview"><div class="ld-brand-logo">L<span>&#183;</span></div><div class="ld-brand-text"><strong>LifeDeck</strong><small>A little more intentional.</small></div></a>
        <NavMenu />
        <div class="ld-sidebar-footer"><span class="ld-local-dot"></span><div><strong>Your personal space</strong><small>Stored on this device</small></div></div>
    </aside>
    @if (menuOpen) { <button class="ld-nav-scrim" aria-label="Close navigation" @onclick="() => menuOpen = false"></button> }
    <div class="ld-workspace">
        <header class="ld-topbar">
            <div class="ld-topbar-leading"><button class="ld-icon-button ld-mobile-toggle" aria-label="Toggle navigation" aria-expanded="@menuOpen" aria-controls="workspace-navigation" @onclick="() => menuOpen = !menuOpen"><DeckIcon Name="menu" /></button><button class="ld-icon-button ld-collapse-toggle" aria-label="@(collapsed ? "Expand sidebar" : "Collapse sidebar")" aria-expanded="@(!collapsed)" aria-controls="workspace-navigation" @onclick="() => collapsed = !collapsed"><DeckIcon Name="menu" /></button><span class="ld-breadcrumb">Workspace <span>/</span> <strong>@PageName</strong></span></div>
            <div class="ld-topbar-actions"><span class="ld-status"><span class="ld-local-dot"></span> Local first</span><button class="ld-icon-button" aria-label="Change color theme" title="Change color theme" @onclick="ToggleTheme"><DeckIcon Name="theme" /></button></div>
        </header>
        <main id="main-content" tabindex="-1" class="ld-content">@Body</main>
    </div>
</div>
@code {
    private void HandleKey(KeyboardEventArgs args) { if (args.Key == "Escape") menuOpen = false; }
    private bool menuOpen;
    private bool collapsed;
    private string PageName => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/') switch {
        "" => "Overview", "logbook" => "Diving Logbook", "todo" => "Todo", "notebook" => "Notebook", "calendar" => "Calendar", "weather" => "Weather", "currency" => "Currency Converter", "calculator" => "Calculator", "account" => "Personal Account", "blog" => "Blog", "backup" => "Data Backup", _ => "Workspace"
    };
    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args) { menuOpen = false; _ = InvokeAsync(StateHasChanged); }
    private async Task ToggleTheme() => await JS.InvokeVoidAsync("lifeDeckTheme.toggle");
    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}

